# ============================================================
# ETP SludgeOps — Backend Environment Variables Template
# ============================================================
# Copy this file to server/.env and fill in your actual values:
# cp server/.env.example server/.env

# Groq API key (get one from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server port (default: 5000)
PORT=5000

# Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Optional: PostgreSQL connection (leave empty to use embedded JSON store)
# DATABASE_URL=postgresql://user:password@localhost:5432/etp_sludge
